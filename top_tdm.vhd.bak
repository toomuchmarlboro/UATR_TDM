library ieee;
use ieee.std_logic_1164.all;

library altera_mf;
use altera_mf.altera_mf_components.all;

entity pll_audio is
    port (
        inclk0 : in  std_logic;
        c0     : out std_logic;
        c1     : out std_logic;
        c2     : out std_logic;
        locked : out std_logic
    );
end entity pll_audio;

architecture rtl of pll_audio is
begin
    altpll_component : altpll
    generic map (
        bandwidth_type         => "AUTO",
        -- c0 = 50 MHz * (1536 / 6250) = 12.288 MHz
        clk0_divide_by         => 6250,
        clk0_duty_cycle        => 50,
        clk0_multiply_by       => 1536,
        clk0_phase_shift       => "0",
        -- c1 = 50 MHz * (1152 / 3125) = 18.432 MHz
        clk1_divide_by         => 3125,
        clk1_duty_cycle        => 50,
        clk1_multiply_by       => 1152,
        clk1_phase_shift       => "0",
        -- c2 = 50 MHz * (1 / 1) = 50 MHz
        clk2_divide_by         => 1,
        clk2_duty_cycle        => 50,
        clk2_multiply_by       => 1,
        clk2_phase_shift       => "0",
        
        compensate_clock       => "CLK0",
        inclk0_input_frequency => 20000, -- 50 MHz expressed in picoseconds
        intended_device_family => "Cyclone IV E",
        lpm_type               => "altpll",
        operation_mode         => "NORMAL",
        
        -- Disable all the unused advanced ports
        port_areset            => "PORT_UNUSED",
        port_inclk1            => "PORT_UNUSED",
        port_pllena            => "PORT_UNUSED",
        port_extclk0           => "PORT_UNUSED",
        port_extclk1           => "PORT_UNUSED",
        port_extclk2           => "PORT_UNUSED",
        port_extclk3           => "PORT_UNUSED",
        
        -- Enable our active ports
        port_inclk0            => "PORT_USED",
        port_locked            => "PORT_USED",
        port_clk0              => "PORT_USED",
        port_clk1              => "PORT_USED",
        port_clk2              => "PORT_USED"
    )
    port map (
        inclk => (0 => inclk0, others => '0'),
        clk(0) => c0,
        clk(1) => c1,
        clk(2) => c2,
        locked => locked
    );
end architecture rtl;