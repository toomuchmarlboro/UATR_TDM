--lpm_compare CBX_DECLARE_ALL_CONNECTED_PORTS="OFF" DEVICE_FAMILY="Cyclone IV E" LPM_PIPELINE=0 LPM_REPRESENTATION="UNSIGNED" LPM_WIDTH=192 ONE_INPUT_IS_CONSTANT="NO" aeb agb alb dataa datab CARRY_CHAIN="MANUAL" CARRY_CHAIN_LENGTH=48
